	dev-build/cmake
	dev-libs/protobuf[protoc(+)]
	virtual/pkgconfig
"

PATCHES=(
	"${FILESDIR}"/${PN}-run-exe-match.patch
)

src_prepare() {
	# cargo cannot override a git source that is itself declared under
	# [patch.crates-io], so point that patch at the GIT_CRATES checkout
	local ntfs_commit=${GIT_CRATES[ntfs]#*;}
	ntfs_commit=${ntfs_commit%%;*}
	sed -i "/^ntfs = /s|git = \"[^\"]*\"|path = \"${WORKDIR}/ntfs-${ntfs_commit}\"|" \
		Cargo.toml || die
	grep -q "^ntfs = { path = " Cargo.toml || die "failed to redirect the ntfs patch"

	default
}

src_install() {
	dobin "$(cargo_target_dir)"/xodus-{cli,service}
	dodoc README.md
	dodoc -r docs/.
}
